{
  "$schema": "https://hygieneroll.com/reference/schema/reference-case-record.schema.json",
  "assumptions": [
    "Delivery normally arrives the day after ordering.",
    "The household keeps a two-day buffer."
  ],
  "case": {
    "id": "HRR-003",
    "purpose": "A one-day lead time with a two-day buffer. The planning window opens late, so a delay longer than the buffer exposes the household at the fast usage bound.",
    "slug": "short-lead-time",
    "status": "PUBLISHED",
    "title": "Short lead-time replenishment (synthetic)",
    "version": 1
  },
  "derivation": [
    "Weekly method: r = 1 roll per week. v = 0.10, so slow = 0.9 and fast = 1.1.",
    "Depletion earliest: 4 / 1.1 × 7 = 25.45 → floor 25. Latest: 4 / 0.9 × 7 = 31.11 → ceiling 32.",
    "Planning trigger: 25 − 1 − 2 = 22 and 32 − 1 − 2 = 29.",
    "Replenishment quantity blank, so cadence equals the depletion window, 25 to 32.",
    "Lead-time demand: 1 × 1.1 / 7 = 0.1571… → 0.16. Reserve: 2 × 1.1 / 7 = 0.3142… → 0.32. Threshold 0.48.",
    "Slip +3: lead 4. Re-planned 25 − 6 = 19 and 32 − 6 = 26. Ordered on day 22, arrival 26. 26 − 25 = 1 day without supply at the fast bound, none at the slow bound.",
    "Slip +7: lead 8. Re-planned 25 − 10 = 15 and 32 − 10 = 22. Arrival 30. 30 − 25 = 5 days at the fast bound. 30 < 32, so none at the slow bound."
  ],
  "evidence": {
    "claim_class": "ILLUSTRATIVE_MODEL",
    "external_observations": [],
    "input_layer": "HYPOTHETICAL_SCENARIO",
    "origin": "SYNTHETIC",
    "output_layer": "DERIVED_CALCULATION",
    "source_ids": [],
    "statement": "Synthetic inputs chosen to exercise the method. They are not observed household behavior, consumption statistics, or benchmarks. Outputs are arithmetic on those inputs."
  },
