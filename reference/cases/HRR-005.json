{
  "$schema": "https://hygieneroll.com/reference/schema/reference-case-record.schema.json",
  "assumptions": [
    "The household holds or is considering a fixed delivery every 35 days.",
    "Each delivery adds 2 bottles."
  ],
  "case": {
    "id": "HRR-005",
    "purpose": "A fixed 35-day delivery schedule is compared with the item's replenishment cadence. The interval falls after the cadence window, so each delivery arrives after the previous quantity would run out.",
    "slug": "fixed-interval-versus-window",
    "status": "PUBLISHED",
    "title": "Fixed subscription interval versus replenishment window (synthetic)",
    "version": 1
  },
  "derivation": [
    "Weekly method: r = 0.5 bottles per week. v = 0.15, so slow = 0.425 and fast = 0.575.",
    "Depletion earliest: 2 / 0.575 × 7 = 24.35 → floor 24. Latest: 2 / 0.425 × 7 = 32.94 → ceiling 33.",
    "Planning trigger: 24 − 4 − 3 = 17 and 33 − 4 − 3 = 26.",
    "Cadence with R = 2 equals the depletion window, 24 to 33.",
    "Interval 35 > 33, so it is later than the window. Drift per delivery: 35 − 33 = 2 to 35 − 24 = 11 days. Supply shrinks each delivery.",
    "Lead-time demand: 4 × 0.575 / 7 = 0.3285… → 0.33. Reserve: 3 × 0.575 / 7 = 0.2464… → 0.25. Threshold 0.58.",
    "Slip +3: lead 7. Re-planned 24 − 10 = 14 and 33 − 10 = 23. Ordered on day 17, arrival 24 = 24, so no gap. 24 > 24 − 3 = 21, so the buffer is drawn.",
    "Slip +7: lead 11. Re-planned 24 − 14 = 10 and 33 − 14 = 19. Arrival 28. 28 − 24 = 4 days at the fast bound, none at the slow bound."
  ],
  "evidence": {
    "claim_class": "ILLUSTRATIVE_MODEL",
    "external_observations": [],
    "input_layer": "HYPOTHETICAL_SCENARIO",
    "origin": "SYNTHETIC",
