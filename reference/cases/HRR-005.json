      "version": "0.1"
    },
    "steps": [
      {
        "concept": "HRO-005",
        "formula": "weekly method: r = weekly_usage; duration method: r = current_quantity / duration_weeks",
        "term": "Consumption rate"
      },
      {
        "concept": "HRO-008",
        "formula": "slow = r × (1 − v); fast = r × (1 + v); v = variability_percent / 100",
        "term": "Usage bounds"
      },
      {
        "concept": "HRO-009",
        "formula": "earliest = floor((q / fast) × 7); latest = ceil((q / slow) × 7); at v = 0 both equal round_half_up((q / r) × 7)",
        "term": "Depletion interval"
      },
      {
        "concept": "HRO-012",
        "formula": "ceil_0.01(lead_time_days × fast / 7)",
        "term": "Lead-time demand"
      },
      {
        "concept": "HRO-013",
        "formula": "ceil_0.01(safety_buffer_days × fast / 7)",
        "term": "Reserve stock"
      },
      {
        "concept": "HRO-014",
        "formula": "lead_time_demand + reserve_stock",
        "term": "Reorder threshold"
      },
      {
        "concept": "HRO-015",
        "formula": "max(0, depletion − lead_time_days − safety_buffer_days), each end separately",
        "term": "Planning trigger"
      },
      {
        "concept": "HRO-017",
        "formula": "same day-window rule as the depletion interval, with replenishment_quantity in place of q",
        "term": "Replenishment cadence"
      },
      {
        "concept": "HRO-019",
        "formula": "EARLIER_THAN_WINDOW if interval < cadence.earliest; LATER_THAN_WINDOW if interval > cadence.latest; otherwise WITHIN_WINDOW; drift = interval − cadence, from latest (min) to earliest (max)",
        "term": "Subscription compatibility"
      },
      {
        "concept": "HRO-020",
        "formula": "arrival = order_day + lead_time; max = max(0, ceil(arrival − depletion.earliest)); min = max(0, ceil(arrival − depletion.latest))",
        "term": "Stockout exposure"
      },
      {
        "concept": "HRO-021",
        "formula": "for each offset s: trigger(depletion, lead_time + s, buffer); stockout_exposure(order_day = trigger.earliest, lead_time + s)",
        "term": "Lead-time slip"
      },
      {
        "concept": "HRO-022",
        "formula": "items with minimum planning_trigger.earliest, in input order",
        "term": "Next household return"
      }
    ]
  },
