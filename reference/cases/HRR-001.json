{
  "$schema": "https://hygieneroll.com/reference/schema/reference-case-record.schema.json",
  "assumptions": [
    "Use is exactly 3 rolls every week.",
    "Lead time and buffer are whole days chosen for the example."
  ],
  "case": {
    "id": "HRR-001",
    "purpose": "A household with steady use and no variability allowance. It shows the simplest path from supply to a single depletion day, a single planning trigger, and a reorder threshold.",
    "slug": "stable-consumption",
    "status": "PUBLISHED",
    "title": "Stable consumption (synthetic)",
    "version": 1
  },
  "derivation": [
    "Weekly method: r = 3 rolls per week. Variability 0%, so slow = fast = 3.",
    "Depletion: 12 / 3 × 7 = 28 days exactly. Single day 28.",
    "Planning trigger: 28 − 3 − 4 = 21.",
    "Replenishment quantity blank, so R = 12 and cadence = 28 days.",
    "Lead-time demand: 3 × 3 / 7 = 1.2857… → rounded up to 1.29. Reserve: 4 × 3 / 7 = 1.7142… → 1.72. Threshold 1.29 + 1.72 = 3.01. 12 > 3.01, so not at or below.",
    "Slip +3: lead 6. Re-planned trigger 28 − 6 − 4 = 18. Ordered on day 21, arrival 27. 27 ≤ 28, so no gap. 27 > 28 − 4 = 24, so the buffer is drawn.",
    "Slip +7: lead 10. Re-planned trigger 28 − 10 − 4 = 14. Arrival 21 + 10 = 31. Gap 31 − 28 = 3 at both bounds."
  ],
  "evidence": {
    "claim_class": "ILLUSTRATIVE_MODEL",
    "external_observations": [],
    "input_layer": "HYPOTHETICAL_SCENARIO",
    "origin": "SYNTHETIC",
    "output_layer": "DERIVED_CALCULATION",
    "source_ids": [],
    "statement": "Synthetic inputs chosen to exercise the method. They are not observed household behavior, consumption statistics, or benchmarks. Outputs are arithmetic on those inputs."
  },
