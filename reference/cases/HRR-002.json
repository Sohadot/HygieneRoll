{
  "$schema": "https://hygieneroll.com/reference/schema/reference-case-record.schema.json",
  "assumptions": [
    "Three bottles usually last six weeks.",
    "Actual use falls anywhere between 25% slower and 25% faster than that rate."
  ],
  "case": {
    "id": "HRR-002",
    "purpose": "Use is entered as how long supply usually lasts, with a 25% variability allowance and a larger replenishment quantity. It shows how the allowance widens every window and how floor and ceiling rounding set each end.",
    "slug": "variable-consumption",
    "status": "PUBLISHED",
    "title": "Variable consumption (synthetic)",
    "version": 1
  },
  "derivation": [
    "Duration method: r = 3 / 6 = 0.5 bottles per week. v = 0.25, so slow = 0.5 × 0.75 = 0.375 and fast = 0.5 × 1.25 = 0.625.",
    "Depletion earliest: 3 / 0.625 × 7 = 33.6 → floor 33. Latest: 3 / 0.375 × 7 = 56 exactly → ceiling 56.",
    "Planning trigger: 33 − 5 − 5 = 23 and 56 − 5 − 5 = 46.",
    "Cadence with R = 4: 4 / 0.625 × 7 = 44.8 → floor 44. 4 / 0.375 × 7 = 74.67 → ceiling 75.",
    "Lead-time demand: 5 × 0.625 / 7 = 0.4464… → 0.45. Reserve: the same, 0.45. Threshold 0.90. 3 > 0.90.",
    "Slip +3: lead 8. Re-planned 33 − 13 = 20 and 56 − 13 = 43. Ordered on day 23, arrival 31 ≤ 33, so no gap. 31 > 33 − 5 = 28, so the buffer is drawn.",
    "Slip +7: lead 12. Re-planned 33 − 17 = 16 and 56 − 17 = 39. Arrival 35. At the fast bound 35 − 33 = 2 days without supply. At the slow bound 35 < 56, so none."
  ],
  "evidence": {
    "claim_class": "ILLUSTRATIVE_MODEL",
    "external_observations": [],
    "input_layer": "HYPOTHETICAL_SCENARIO",
    "origin": "SYNTHETIC",
    "output_layer": "DERIVED_CALCULATION",
    "source_ids": [],
    "statement": "Synthetic inputs chosen to exercise the method. They are not observed household behavior, consumption statistics, or benchmarks. Outputs are arithmetic on those inputs."
