{
  "$schema": "https://hygieneroll.com/reference/schema/reference-case-record.schema.json",
  "assumptions": [
    "Delivery normally takes 12 days.",
    "The household wants 4 days of buffer."
  ],
  "case": {
    "id": "HRR-004",
    "purpose": "Lead time plus buffer is longer than the supply lasts. The planning trigger is clamped to Now, supply is already at or below the reorder threshold, and any delay leaves days without supply at both bounds.",
    "slug": "delayed-delivery-stockout",
    "status": "PUBLISHED",
    "title": "Delayed delivery and stockout exposure (synthetic)",
    "version": 1
  },
  "derivation": [
    "Weekly method: r = 1 pack per week. Variability 0%.",
    "Depletion: 2 / 1 × 7 = 14 days.",
    "Planning trigger: 14 − 12 − 4 = −2 → clamped to 0, shown as Now.",
    "Lead-time demand: 12 × 1 / 7 = 1.7142… → 1.72. Reserve: 4 / 7 = 0.5714… → 0.58. Threshold 2.30. Supply 2 ≤ 2.30, so it is at or below the threshold.",
    "Slip +3: lead 15. Re-planned 14 − 19 = −5 → 0. Ordered on day 0, arrival 15. 15 − 14 = 1 day without supply.",
    "Slip +7: lead 19. Re-planned 0. Arrival 19. 19 − 14 = 5 days without supply."
  ],
  "evidence": {
    "claim_class": "ILLUSTRATIVE_MODEL",
    "external_observations": [],
    "input_layer": "HYPOTHETICAL_SCENARIO",
    "origin": "SYNTHETIC",
    "output_layer": "DERIVED_CALCULATION",
    "source_ids": [],
    "statement": "Synthetic inputs chosen to exercise the method. They are not observed household behavior, consumption statistics, or benchmarks. Outputs are arithmetic on those inputs."
  },
